{
    "layer": "top",
    "position": "top",
    "height": 33,
    "margin-top": 5,
    "margin-left": 10,
    "margin-right": 10,

    "modules-left": ["custom/distro-icon", "hypr/workspaces"],
    "modules-center": ["memory", "custom/temperature"], 
    "modules-right": ["hypr/language", "pulseaudio", "network", "clock", "custom/power"],

    "niri/workspaces": {
        "all-outputs": true
    },

    "custom/temperature": {
        "exec": "sensors | grep 'Package id 0' | awk '{print $4}' | sed 's/+//' | sed 's/°C//'",
        "interval": 5,
        "format": " {}°C"
    },

    "niri/language": {
        "format": " {}"
    },

    "custom/distro-icon": {
        "format": "",
        "on-click": "fuzzel"
    },

    "clock": {
        "format": "{:%H:%M | %d %b}"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-icons": {
            "default": ["", "", ""]
        }
    },

    "network": {
        "format-wifi": "",
        "format-ethernet": "󰈀",
        "format-disconnected": "⚠️"
    },

    "memory": {
        "interval": 5,
        "format": "󰍛 {used:0.1f}G"
    },

    "custom/power": {
        "format": "⏻",
        "on-click": "poweroff"
    }
}
